#!name=Sofascore AdBlock
#!desc=Block ads and trackers for Sofascore app
#!author=YourName
#!homepage=https://github.com/YourName/Surge-Modules
#!icon=https://www.sofascore.com/favicon.ico

[MITM]

hostname = %APPEND%
*.sofascore.com


[Rule]

# Sofascore advertising
DOMAIN-SUFFIX,ads.sofascore.com,REJECT-TINYGIF

# Google Ads
DOMAIN-SUFFIX,doubleclick.net,REJECT-TINYGIF
DOMAIN-SUFFIX,googlesyndication.com,REJECT-TINYGIF
DOMAIN-SUFFIX,googleadservices.com,REJECT-TINYGIF
DOMAIN-SUFFIX,google-analytics.com,REJECT

# App tracking
DOMAIN-SUFFIX,appsflyer.com,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,branch.io,REJECT

# Facebook tracking
DOMAIN-SUFFIX,facebook.net,REJECT
DOMAIN-SUFFIX,facebook.com,REJECT

# Generic advertising
DOMAIN-SUFFIX,adnxs.com,REJECT-TINYGIF
DOMAIN-SUFFIX,adsrvr.org,REJECT-TINYGIF
DOMAIN-SUFFIX,criteo.com,REJECT-TINYGIF